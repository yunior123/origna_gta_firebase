{
  "description": "Complete address model with validation\nUsed for delivery, seller locations, and user addresses",
  "example": {
    "apartment": "Apt 4B",
    "city": "Toronto",
    "country": "Canada",
    "isDefault": true,
    "label": "Home",
    "phoneNumber": "4165551234",
    "postalCode": "M5V 3A8",
    "state": "ON",
    "street": "123 Main Street"
  },
  "properties": {
    "addressId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Firestore document ID for this address (set by server, null on create)",
      "title": "Addressid"
    },
    "street": {
      "description": "Street address",
      "maxLength": 100,
      "minLength": 1,
      "title": "Street",
      "type": "string"
    },
    "apartment": {
      "default": "",
      "description": "Unit, Suite, Apt number",
      "maxLength": 20,
      "title": "Apartment",
      "type": "string"
    },
    "city": {
      "description": "City name",
      "maxLength": 50,
      "minLength": 2,
      "title": "City",
      "type": "string"
    },
    "state": {
      "description": "Province/State code (e.g., ON, QC, BC)",
      "maxLength": 2,
      "minLength": 2,
      "title": "State",
      "type": "string"
    },
    "postalCode": {
      "description": "Canadian postal code (e.g., M5V 3A8)",
      "title": "Postalcode",
      "type": "string"
    },
    "country": {
      "default": "Canada",
      "description": "Country name",
      "title": "Country",
      "type": "string"
    },
    "phoneNumber": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Contact phone number for delivery",
      "title": "Phonenumber"
    },
    "isDefault": {
      "default": false,
      "description": "Whether this is the default address",
      "title": "Isdefault",
      "type": "boolean"
    },
    "label": {
      "anyOf": [
        {
          "maxLength": 20,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Address label (Home, Work, Other)",
      "title": "Label"
    },
    "latitude": {
      "anyOf": [
        {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Latitude for mapping/delivery routing",
      "title": "Latitude"
    },
    "longitude": {
      "anyOf": [
        {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Longitude for mapping/delivery routing",
      "title": "Longitude"
    }
  },
  "required": [
    "street",
    "city",
    "state",
    "postalCode"
  ],
  "title": "Address",
  "type": "object"
}